{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  },
  "deploy": {
    "production": {
      "hosting": {
        "web": {
          "dir": "dist",
          "public": true
        }
      }
    }
  }
}
